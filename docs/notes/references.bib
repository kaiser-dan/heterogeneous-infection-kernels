  url = {https://epjds.epj.org/articles/epjdata/abs/2024/01/13688_2024_Article_451/13688_2024_Article_451.html},
  urldate = {2025-08-11},
  abstract = {From small steps to great leaps, metaphors of spatial mobility abound to describe discovery processes. Here, we ground these ideas in formal terms by systematically studying mobility patterns in the scientific knowledge landscape. We use low-dimensional embedding techniques to create a knowledge space made up of 1.5 million articles from the fields of physics, computer science, and mathematics. By analyzing the publication histories of individual researchers, we discover patterns of scientific mobility that closely resemble physical mobility. In aggregate, the trajectories form mobility flows that can be described by a gravity model, with jumps more likely to occur in areas of high density and less likely to occur over longer distances. We identify two types of researchers from their individual mobility patterns: interdisciplinary \mkbibemph{explorers{$<$}i/{$>$} who pioneer new fields, and \mkbibemph{exploiters{$<$}i/{$>$} who are more likely to stay within their specific areas of expertise. Our results suggest that spatial mobility analysis is a valuable tool for understanding the evolution of science.}}},
  langid = {english},
  file = {C\:\\Users\\pny2cw\\Zotero\\storage\\HQC3NRD9\\Singh et al. - 2024 - Charting mobility patterns in the scientific knowledge landscape.pdf;C\:\\Users\\pny2cw\\Zotero\\storage\\ZSQJZFUS\\13688_2024_Article_451.html}
}

