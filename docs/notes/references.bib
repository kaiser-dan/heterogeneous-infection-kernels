@online{ostendorffAspectbasedDocumentSimilarity2020,
  title = {Aspect-Based {{Document Similarity}} for {{Research Papers}}},
  author = {Ostendorff, Malte and Ruas, Terry and Blume, Till and Gipp, Bela and Rehm, Georg},
  date = {2020-10-13},
