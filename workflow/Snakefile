"""Top-level Snakemake entry point. Orchestration layer only."""

import sys
from pathlib import Path

configfile: "config/config.yaml"

RESULTS = config.get("results_root", "results")

WORKFLOW = Path(workflow.basedir)
ROOT = WORKFLOW.parent
SCRIPTS = WORKFLOW / "scripts"
if str(SCRIPTS) not in sys.path:
    sys.path.insert(0, str(SCRIPTS))

# DGP helpers shared by every rule file below
from dgp_shapes import (
    build_sweep_sbm_dgp, 
    build_sweep_edgelist_dgp,
    build_cv_dgp, 
    cv_kernel_files
)

include: "rules/sweep.smk"
include: "rules/cv.smk"
include: "rules/ppc.smk"

# SWEEP_NAMES comes from rules/sweep.smk
# CV_EXPERIMENT comes from rules/cv.smk
# PPC_OMEGAS comes from rules/ppc.smk

